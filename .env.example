# PostgreSQL connection string.
# Local (docker compose): postgresql://livehive:livehive@localhost:5432/livehive
# Production: use Vercel Postgres, Neon, or another managed Postgres provider.
DATABASE_URL="postgresql://livehive:livehive@localhost:5432/livehive"

# Direct (non-pooled) URL. Some providers (Neon, Prisma Accelerate, Vercel Postgres)
# require this for migrations. If you only have one URL, set it to the same value.
DIRECT_URL="postgresql://livehive:livehive@localhost:5432/livehive"

# 32+ character secret used to sign session cookies.
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Public site origin. Used for canonical URLs, sitemap, and session cookies.
# Production: https://livehive.dev
APP_URL="http://localhost:3000"

# 32-byte hex key used to encrypt APNs private keys at rest (AES-256-GCM).
# Generate: openssl rand -hex 32
ENCRYPTION_KEY="replace-with-64-hex-chars"

# Shared secret for the delivery cron/worker endpoint.
# Generate: openssl rand -base64 32
CRON_SECRET="replace-with-a-long-random-string"

# Optional. Set to "true" to treat unset APNs credentials as a hard error in
# production. Defaults to true when NODE_ENV=production.
# REQUIRE_APNS="true"

# Optional. Override the APNs host (tests only). Leave unset in production.
# APNS_HOST="api.sandbox.push.apple.com"
