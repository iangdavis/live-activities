# Server API Key from the Live Hive project. Never put this in the iOS app.
LIVEHIVE_API_KEY=lh_live_...

# Working host. api.livehive.dev is NXDOMAIN unless you added DNS.
LIVEHIVE_API_BASE=https://www.livehive.dev/v1

PORT=8787

# Delay between start→update and update→end (milliseconds).
DEMO_STEP_MS=10000
